---
import OCR from '../layouts/OCR.astro';
import snapshot from '../../public/results.json';
import { modelOpenness } from '../data/ocr-openness';
import { criteria, opennessIcon, statusLabels, opennessAnchor } from '../lib/ocr-openness';
---
<OCR title="Model openness" description="Six openness checks for each model, with evidence and sources." active="methodology">
  <header class="page-heading"><div><h1>Model openness</h1><p>What each model makes available.</p></div><a href="/OCR-eval/">Back to leaderboard →</a></header>
  <div class="openness-intro prose">
    <p>Six icons describe each model’s weights, license, training code, training data, paper and documentation, following <a href="https://huggingface.co/spaces/RyeAI/danish-asr-leaderboard">Danish ASR</a> and <a href="https://leaderboard.mteb.org/models">MTEB</a>. Red icons mark confirmed availability. Hover over an icon on the leaderboard for an explanation, or select it to read the evidence.</p>
    <details class="criteria-details"><summary>What each icon means</summary><dl>{criteria.map(([key, label, description]) => <div><dt><span class="criterion-icon" set:html={opennessIcon(key)} />{label}</dt><dd>{description}</dd></div>)}</dl>
      <p>Checks apply to the evaluated model’s published materials. Faded icons can mean partial availability, a closed release, or insufficient information; each is labelled separately in the evidence. The criteria are not combined into a score.</p>
      <p>These are ScandiOCR’s assessments. Openness does not affect OCR scores or rankings.</p>
    </details>
  </div>
  <section class="openness-models" aria-label="Evidence by model">
    {snapshot.models.map(model => {
      const profile = modelOpenness[model.id];
      return <details class="openness-model" id={model.id}>
        <summary><span>{model.name}</span><span class="openness-icons">{criteria.map(([key, label]) => <span class={`criterion-icon ${profile.checks[key].status}`} role="img" aria-label={`${label}: ${statusLabels[profile.checks[key].status]}`} title={`${label}: ${statusLabels[profile.checks[key].status]}`} set:html={opennessIcon(key)} />)}</span></summary>
        <div class="openness-content">
          <div class="evidence-scroll" tabindex="0" aria-label={`Openness evidence for ${model.name}`}>
            <table class="evidence-table"><caption class="sr-only">Six openness checks for {model.name}</caption><thead><tr><th scope="col">Check</th><th scope="col">Status</th><th scope="col">Evidence</th></tr></thead>
              <tbody>{criteria.map(([key, label]) => {
                const item = profile.checks[key];
                return <tr id={`${model.id}--${key}`} tabindex="-1"><th scope="row"><span class="criterion-icon" set:html={opennessIcon(key)} />{label}</th><td><span class={`check-status ${item.status}`}>{statusLabels[item.status]}</span></td><td><p>{item.note}</p><div class="evidence-links">{item.sources.map((source, i) => <a href={source} target="_blank" rel="noreferrer">Source{item.sources.length > 1 ? ` ${i + 1}` : ''} ↗</a>)}</div></td></tr>;
              })}</tbody>
            </table>
          </div>
          <p class="review-date">Reviewed {profile.reviewed} · <a href={`/OCR-eval/openness/#${opennessAnchor(model.id)}`}>Link to this model</a></p>
        </div>
      </details>;
    })}
  </section>
  <script>
    function revealModel() {
      let id: string;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      const model = target?.closest('details');
      if (model instanceof HTMLDetailsElement) {
        model.open = true; target!.scrollIntoView({ block: 'center' });
        if (target instanceof HTMLTableRowElement) target.focus({ preventScroll: true });
      }
    }
    revealModel(); window.addEventListener('hashchange', revealModel);
  </script>
</OCR>
<style>
  .openness-intro { max-width:850px; margin-bottom:28px; }
  .openness-intro p { font-size:14px; }
  .criteria-details { margin-top:18px; }
  summary { cursor:pointer; }
  .criteria-details summary { color:var(--red); font-size:14px; }
  dl>div { display:grid; grid-template-columns:160px 1fr; gap:20px; margin:14px 0; font-size:13px; }
  dt { font-weight:600; } dd { margin:0; }
  .criterion-icon { display:inline-flex; vertical-align:middle; color:#a3a3ac; }
  .criterion-icon :global(svg) { width:18px; height:18px; }
  .criterion-icon.yes { color:var(--red); }
  dt .criterion-icon,.evidence-table th .criterion-icon { margin-right:8px; color:var(--muted); }
  .openness-model { border-top:1px solid var(--line); scroll-margin-top:20px; }
  .openness-model:last-child { border-bottom:1px solid var(--line); }
  .openness-model>summary { display:flex; align-items:center; gap:12px; padding:18px 8px; font-size:14px; list-style:none; }
  .openness-model>summary::-webkit-details-marker { display:none; }
  .openness-model>summary::before { content:'›'; font-size:18px; }
  .openness-model[open]>summary::before { transform:rotate(90deg); }
  .openness-model>summary>span:first-child { flex:1; min-width:0; overflow-wrap:anywhere; }
  .openness-icons { display:inline-flex; gap:8px; flex:none; }
  .openness-model[open]>summary { color:var(--red); }
  .openness-content { padding:0 8px 20px; }
  .evidence-scroll { overflow:auto; }
  .evidence-table { width:100%; border-collapse:collapse; font-size:12px; }
  .evidence-table th,.evidence-table td { text-align:left; padding:12px; border-bottom:1px solid var(--line); vertical-align:top; }
  .evidence-table thead { background:var(--soft); }
  .evidence-table th:first-child { width:20%; }
  .evidence-table th:nth-child(2) { width:15%; }
  .evidence-table p { color:var(--muted); line-height:1.6; margin-top:5px; }
  .evidence-table tr { scroll-margin:20px; }
  .evidence-table tr:target { background:var(--red-soft); }
  .check-status { font-weight:600; }
  .check-status.unknown { color:var(--muted); font-weight:400; }
  .check-status.no,.check-status.partial { color:var(--red); }
  .evidence-links { display:flex; flex-wrap:wrap; gap:12px; margin-top:6px; }
  .review-date { font-size:11px; color:var(--muted); margin-top:14px; }
  @media(max-width:680px) {
    .evidence-table thead { display:none; }
    .evidence-table tr { display:grid; grid-template-columns:1fr auto; border-bottom:1px solid var(--line); padding:8px 0; }
    .evidence-table th,.evidence-table td { width:auto; padding:4px 8px; border:0; }
    .evidence-table th:first-child { width:auto; }
    .evidence-table td:last-child { grid-column:1 / -1; }
    .openness-model>summary { font-size:12px; flex-wrap:wrap; }
    .openness-model>summary>span:first-child { flex-basis:calc(100% - 28px); }
    .openness-icons { margin-left:20px; }
    dl>div { grid-template-columns:1fr; gap:4px; }
  }
</style>

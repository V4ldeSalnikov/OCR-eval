---
import OCR from '../layouts/OCR.astro';
import snapshot from '../../public/results.json';
import { benchmarks } from '../data/ocr-benchmarks';
import '../styles/ocr-matrix.css';
---
<OCR title="Leaderboard" description="Task-by-task OCR scores for Danish, Norwegian and Swedish documents." active="leaderboard">
  <div class="task-leaderboard">
    <header class="page-heading">
      <div><h1>Leaderboard</h1><p>OCR for Danish, Norwegian and Swedish.</p></div>
      <div class="leaderboard-actions">
        <p class="benchmark-size">{snapshot.models.length} models <span>·</span> {snapshot.datasets.length} datasets</p>
        <a class="request-model" href="https://github.com/V4ldeSalnikov/OCR-eval/issues/new?template=model-evaluation.yml">Request a model <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <section id="leaderboard" aria-label="Model scores">
      <div class="view-switch" role="group" aria-label="Leaderboard view"><button type="button" data-view="table" aria-pressed="true">Table</button><button type="button" data-view="size" aria-pressed="false">Pareto</button></div>
      <div class="matrix-controls">
        <label class="matrix-select"><span>Benchmark</span><select id="benchmark-select">{benchmarks.map(item => <option value={item.id}>{item.name} · {item.version}</option>)}</select></label>
        <div class="matrix-select metric-control">
          <div class="control-label"><span id="metric-label">Metric</span><div class="score-help">
            <button type="button" class="score-help-trigger" aria-label="About metrics" aria-controls="metric-help" aria-expanded="false">?</button>
            <div id="metric-help" class="score-popover" role="region" aria-label="Error metrics" hidden>
              <p><strong>Word error rate (WER)</strong> counts word substitutions, deletions and insertions relative to the reference text.</p>
              <p><strong>Character error rate (CER)</strong> measures the same errors at the character level.</p>
              <p>Lower is better. Extra text can push either score above 100%.</p>
              <a href="/OCR-eval/methodology/#metrics">Read more about metrics →</a>
            </div>
          </div></div>
          <div class="metric-switch" role="group" aria-labelledby="metric-label"><button type="button" data-metric="wer" aria-pressed="true" title="Word error rate">WER</button><button type="button" data-metric="cer" aria-pressed="false" title="Character error rate">CER</button></div>
        </div>
        <div class="matrix-select" id="aggregation-control">
          <div class="control-label"><label for="aggregation-select">Aggregation</label><div class="score-help">
            <button type="button" class="score-help-trigger" aria-label="About aggregation" aria-controls="aggregation-help" aria-expanded="false">?</button>
            <div id="aggregation-help" class="score-popover" role="region" aria-label="Score aggregation" hidden>
              <p><strong>Mean:</strong> average error rate across tasks, with equal weight for each task. Lower is better.</p>
              <p><strong>Win rate:</strong> estimated chance of beating another model, fitted from task comparisons using Bradley–Terry. Higher is better.</p>
              <p><strong>Borda rank:</strong> average rank across tasks; ties share the average position. Lower is better.</p>
              <p>Overall scores require results on every task. Individual task cells always show the selected error rate.</p>
              <a href="/OCR-eval/methodology/#ranking">Read more about aggregation →</a>
            </div>
          </div></div>
          <select id="aggregation-select"><option value="mean">Mean</option><option value="win-rate">Win rate</option><option value="borda">Borda rank</option></select>
        </div>
        <label class="matrix-select size-task-control" id="size-task-control" hidden><span>Task</span><select id="size-task"><option value="overall">Overall · mean across tasks</option></select></label>
        <label class="search-control"><span class="sr-only">Search models</span><input type="search" id="model-search" placeholder="Search models" /></label>
      </div>
      <div class="matrix-context">
        <span><span id="selection-description">Loading scores…</span> <a id="benchmark-about" href="/OCR-eval/benchmarks/scandinavian/">About this benchmark ↗</a></span>
      </div>
      <div id="load-error" class="message" role="alert" hidden></div>
      <div id="table-view">
      <div class="matrix-scroll" tabindex="0" aria-label="Task scores. Scroll horizontally for more tasks.">
        <table class="task-matrix"><caption class="sr-only" id="table-caption">Model scores for every task in the selected benchmark.</caption><colgroup id="matrix-columns"></colgroup><thead id="results-head"></thead><tbody id="results-body"></tbody></table>
      </div>
      <p id="table-status" class="message" role="status" aria-live="polite">Loading model scores…</p>
      <div class="table-footer"><span id="visible-models" aria-live="polite"></span><span>Bold = best task score · Click a score for examples · — = unavailable</span></div>
      </div>
      <section id="size-view" aria-label="Performance by model size" hidden>
        <div class="size-caption"><p>Lower error, fewer parameters.</p><div class="size-legend"><span><i class="frontier"></i>Pareto frontier</span><span><i></i>Other models</span></div></div>
        <div class="size-layout"><div id="size-chart"></div><aside id="size-detail" aria-label="Selected model details" aria-live="polite"></aside></div>
        <div class="size-footer"><span id="size-count"></span><a href="/OCR-eval/methodology/#model-size">About parameter estimates →</a></div>
        <details class="size-omissions" id="size-omissions"><summary>Models without parameter estimates</summary><p id="size-unknown"></p></details>
      </section>
    </section>
    <noscript><p class="message">Enable JavaScript to explore scores, or <a href="/OCR-eval/results.json">download the results</a>.</p></noscript>
  </div>
  <script>import '../scripts/ocr-leaderboard';</script>
</OCR>
